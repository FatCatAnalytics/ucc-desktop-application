+                Path::new("/3/7"),
+                Path::new("/3/8"),
+                Path::new("/3/9"),
+                Path::new("/4"),
+                Path::new("/5"),
+                Path::new("/6"),
+            ]
+        );
+    }
+
+    #[test]
+    fn preorder_entries_from_storage() {
+        let minialloc = make_minialloc();
+        let entries: Vec<Entry> = Entries::new(
+            EntriesOrder::Preorder,
+            &minialloc,
+            PathBuf::from("/"),
+            3,
+        )
+        .collect();
+        let paths = paths_for_entries(&entries);
+        assert_eq!(
+            paths,
+            vec![
+                Path::new("/3"),
+                Path::new("/3/7"),
+                Path::new("/3/8"),
+                Path::new("/3/9")
+            ]
+        );
+    }
+}
