+                f.write_str("[")?;
+                let s = self
+                    .0
+                    .iter()
+                    .map(|(input, output)| format!("('{input}', '{output}')"))
+                    .collect::<Vec<_>>()
+                    .join(", ");
+                f.write_str(&s)?;
